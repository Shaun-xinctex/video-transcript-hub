# Supabase project the app talks to.
# Local dev: copy to .env.local and fill in.
# Production: add the same variables in Vercel -> Settings -> Environment Variables.
NEXT_PUBLIC_SUPABASE_URL="https://<your-project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# SERVER-ONLY. Bypasses RLS - never prefix with NEXT_PUBLIC_, never commit a real value.
# Put the real value in .env.local (gitignored) and in Vercel as a sensitive env var.
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxx"
